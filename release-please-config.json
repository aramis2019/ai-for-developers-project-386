{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "meetly",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Функциональность" },
        { "type": "fix", "section": "Исправления" },
        { "type": "perf", "section": "Производительность" },
        { "type": "refactor", "section": "Рефакторинг" },
        { "type": "docs", "section": "Документация" },
        { "type": "build", "section": "Сборка" },
        { "type": "ci", "section": "CI" },
        { "type": "test", "section": "Тесты", "hidden": true },
        { "type": "style", "section": "Стиль", "hidden": true },
        { "type": "chore", "section": "Разное", "hidden": true }
      ]
    }
  }
}
