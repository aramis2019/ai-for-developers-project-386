import "@typespec/http";

using TypeSpec.Http;

namespace Meetly;

// ---------------------------------------------------------------------------
// Скалярные типы
// ---------------------------------------------------------------------------

/**
 * Идентификатор типа события. Задаётся владельцем календаря вручную,
 * читаемый slug в нижнем регистре, участвует в публичных ссылках.
 */
@minLength(1)
@maxLength(64)
@pattern(
  "^[a-z0-9]+(?:-[a-z0-9]+)*$",
  "Slug в нижнем регистре: латиница, цифры и дефис"
)
scalar EventTypeId extends string;

/** Идентификатор бронирования. Генерируется сервером (UUID v4). */
@format("uuid")
scalar BookingId extends string;

/** Время суток в формате `HH:mm` (UTC). */
@pattern("^([01][0-9]|2[0-3]):[0-5][0-9]$", "Время суток в формате HH:mm")
scalar TimeOfDay extends string;

/** Адрес электронной почты. */
@format("email")
@maxLength(254)
scalar Email extends string;

// ---------------------------------------------------------------------------
// Владелец календаря
// ---------------------------------------------------------------------------

/**
 * Рабочие часы владельца календаря в UTC.
 * Слоты формируются только внутри этого промежутка, `end` строго больше `start`.
 */
model WorkingHours {
  /** Начало рабочего дня, UTC. */
  @example("09:00")
  start: TimeOfDay;

  /** Конец рабочего дня, UTC. Встреча должна завершиться не позже него. */
  @example("18:00")
  end: TimeOfDay;
}

/**
 * Владелец календаря — единственный заранее заданный профиль системы.
 * Не создаётся и не удаляётся через API, доступен только для чтения.
 */
model Owner {
  /** Стабильный идентификатор профиля. */
  @example("owner")
  id: string;

  /** Отображаемое имя владельца на публичных страницах. */
  @minLength(1)
  @maxLength(120)
  @example("Анна Смирнова")
  name: string;

  /** Контактный e-mail владельца. */
  email: Email;

  /** Часовой пояс расписания. В текущей версии всегда `UTC`. */
  @example("UTC")
  timeZone: "UTC";

  /** Рабочие часы, внутри которых строится сетка слотов. */
  workingHours: WorkingHours;

  /** Шаг сетки слотов в минутах. В текущей версии всегда 30. */
  @example(30)
  slotStepMinutes: int32;

  /** Глубина окна записи в сутках от текущего момента. В текущей версии всегда 14. */
  @example(14)
  bookingWindowDays: int32;
}

// ---------------------------------------------------------------------------
// Тип события
// ---------------------------------------------------------------------------

/** Тип события (вид брони), который владелец предлагает гостям. */
model EventType {
  /** Идентификатор, заданный владельцем при создании. */
  @example("intro-call")
  id: EventTypeId;

  /** Название, которое видит гость. */
  @minLength(1)
  @maxLength(120)
  @example("Знакомство")
  title: string;

  /** Описание встречи: о чём она и как проходит. */
  @maxLength(1000)
  @example("Короткий созвон, чтобы обсудить задачу и понять, чем я могу помочь.")
  description: string;

  /**
   * Длительность встречи в минутах. Определяет длину интервала `[start, end)`
   * и то, какие слоты сетки помещаются в рабочие часы.
   */
  @minValue(5)
  @maxValue(480)
  @example(30)
  durationMinutes: int32;

  /** Момент создания типа события, UTC. */
  createdAt: utcDateTime;
}

/** Данные для создания типа события. Идентификатор задаёт владелец. */
model EventTypeCreate {
  /** Уникальный идентификатор типа события. */
  id: EventTypeId;

  @minLength(1)
  @maxLength(120)
  title: string;

  @maxLength(1000)
  description: string;

  @minValue(5)
  @maxValue(480)
  durationMinutes: int32;
}

/** Публичная карточка типа события: всё, что нужно гостю для выбора. */
model PublicEventType {
  id: EventTypeId;
  title: string;
  description: string;
  durationMinutes: int32;
}

// ---------------------------------------------------------------------------
// Слот
// ---------------------------------------------------------------------------

/**
 * Слот — вычисляемый интервал-кандидат для встречи. Отдельно не хранится:
 * сетка строится на лету из рабочих часов владельца, шага сетки и длительности
 * выбранного типа события, а затем из неё вычитаются занятые интервалы.
 */
model Slot {
  /** Начало слота, UTC. Всегда выровнено по шагу сетки. */
  @example(utcDateTime.fromISO("2026-08-17T09:30:00Z"))
  start: utcDateTime;

  /** Конец слота, UTC. Равен `start + durationMinutes` выбранного типа события. */
  @example(utcDateTime.fromISO("2026-08-17T10:00:00Z"))
  end: utcDateTime;
}

/** Окно записи, внутри которого действителен список слотов. */
model BookingWindow {
  /** Начало окна, UTC. Момент выполнения запроса. */
  from: utcDateTime;

  /** Конец окна, UTC. Ровно `from + 14 суток`. */
  to: utcDateTime;
}

/** Ответ со свободными слотами для конкретного типа события. */
model SlotsPage {
  /** Тип события, для которого построена сетка. */
  eventTypeId: EventTypeId;

  /** Длительность встречи, использованная при построении сетки. */
  durationMinutes: int32;

  /** Часовой пояс возвращаемых значений времени. */
  timeZone: "UTC";

  /** Границы окна записи. */
  window: BookingWindow;

  /**
   * Только свободные слоты, отсортированные по `start` по возрастанию.
   * Занятые интервалы в ответ не попадают. Пустой массив — записаться некуда.
   */
  slots: Slot[];
}

// ---------------------------------------------------------------------------
// Бронирование
// ---------------------------------------------------------------------------

/** Контактные данные гостя. Аккаунт не создаётся, данные живут внутри брони. */
model Guest {
  /** Имя гостя. */
  @minLength(1)
  @maxLength(120)
  @example("Игорь Петров")
  name: string;

  /** E-mail гостя для подтверждения встречи. */
  email: Email;

  /** Необязательный комментарий: тема встречи, вопросы, ссылки. */
  @maxLength(1000)
  note?: string;
}

/** Подтверждённое бронирование слота гостем. */
model Booking {
  /** Идентификатор брони, выданный сервером. */
  id: BookingId;

  /** Тип события, на который записался гость. */
  eventTypeId: EventTypeId;

  /** Название типа события на момент чтения — чтобы не делать второй запрос. */
  eventTypeTitle: string;

  /** Начало встречи, UTC. */
  start: utcDateTime;

  /** Конец встречи, UTC. Вычисляется как `start + durationMinutes`. */
  end: utcDateTime;

  /** Длительность встречи в минутах, зафиксированная при бронировании. */
  durationMinutes: int32;

  /** Контактные данные гостя. */
  guest: Guest;

  /** Момент создания брони, UTC. */
  createdAt: utcDateTime;
}

/**
 * Запрос на создание брони. Гость передаёт только начало встречи —
 * конец сервер вычисляет сам из длительности типа события.
 */
model BookingCreate {
  /** Выбранный тип события. */
  eventTypeId: EventTypeId;

  /** Начало выбранного слота, UTC. Должно совпадать со слотом из `SlotsPage`. */
  start: utcDateTime;

  /** Контактные данные гостя. */
  guest: Guest;
}

/** Список бронирований для админской части. */
model BookingList {
  /** Бронирования всех типов событий в одном списке, отсортированы по `start`. */
  items: Booking[];
}

/** Список типов событий. */
model EventTypeList {
  items: EventType[];
}

/** Публичный список типов событий. */
model PublicEventTypeList {
  items: PublicEventType[];
}
