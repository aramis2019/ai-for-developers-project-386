import "@typespec/http";
import "@typespec/openapi";
import "./spec/errors.tsp";
import "./spec/models.tsp";
import "./spec/admin.tsp";
import "./spec/public.tsp";

using TypeSpec.Http;
using TypeSpec.OpenAPI;

/**
 * Meetly — сервис записи на встречи с одним владельцем календаря.
 *
 * Роли:
 *
 * - **Владелец календаря** — единственный заранее заданный профиль. Регистрации и авторизации нет: любой запрос к `/api/admin/*` выполняется от имени этого профиля.
 * - **Гость** — анонимный посетитель. Просматривает типы событий и свободные слоты, создаёт бронирование без аккаунта.
 *
 * Соглашения контракта:
 *
 * - Все моменты времени передаются в UTC в формате ISO 8601 с суффиксом `Z` (например, `2026-08-17T09:30:00Z`). Локализация — задача клиента.
 * - Интервал встречи — полуинтервал `[start, end)`.
 * - Окно записи — 14 суток от текущего момента.
 * - Занятость сквозная: два бронирования не могут пересекаться по времени, даже если относятся к разным типам событий.
 */
@service(#{ title: "Meetly Scheduling API" })
@info(#{
  version: "1.0.0",
  license: #{ name: "MIT", url: "https://opensource.org/licenses/MIT" },
})
@tagMetadata(
  "Admin",
  #{
    description: "Админская часть. Работает от имени единственного заранее заданного владельца календаря.",
  }
)
@tagMetadata(
  "Public",
  #{
    description: "Публичная часть для гостя. Аккаунт и вход не требуются, все эндпоинты анонимны.",
  }
)
@server("http://localhost:3000", "Локальный сервер разработки")
namespace Meetly;
