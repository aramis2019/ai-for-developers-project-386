<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Локальный источник пакетов для этого репозитория.

    <clear/> отменяет глобальные источники из %APPDATA%\NuGet\NuGet.Config
    (в т.ч. корпоративные зеркала), чтобы restore был воспроизводим
    на машине разработчика и в GitHub Actions одинаково.

    Если нужен приватный фид — добавьте его сюда явно, рядом с nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Глобальный конфиг машины может держать nuget.org в disabled — <clear/> выше
    этого не отменяет, disabledPackageSources чистится отдельно.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
